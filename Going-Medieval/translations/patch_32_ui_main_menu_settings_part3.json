  },
  {
    "key": "menu_migrating",
    "type": 0,
    "en": "Migrating",
    "vi": "Đang Chuyển Đổi Dữ Liệu Lưu..."
  },
  {
    "key": "menu_alcohol",
    "type": 0,
    "en": "Alcohol Requirement",
    "vi": "Nhu Cầu Rượu Bia"
  },
  {
    "key": "info_menu_alcohol",
    "type": 0,
    "en": "The amount of alcohol a settler requires. If this need is not met, the settler will be unhappy.",
    "vi": "Lượng rượu bia dân làng cần uống. Nếu không được đáp ứng, dân làng sẽ cảm thấy buồn bực và giảm tâm trạng."
  },
  {
    "key": "info_menu_faith",
    "type": 0,
    "en": "The amount of religious activity this settler requires. Settlers aligned farther from the center will need religious activities more often. If this need is not met, the settler will be unhappy.",
    "vi": "Nhu cầu cầu nguyện và tham gia nghi lễ tôn giáo. Những người có đức tin càng sâu đậm sẽ cần cầu nguyện thường xuyên hơn. Nếu không được đáp ứng, họ sẽ cảm thấy bất an."
  },
  {
    "key": "menu_faith",
    "type": 0,
    "en": "Religious Activities",
    "vi": "Nghi Lễ Tôn Giáo"
  },
  {
    "key": "menu_entertaiment",
    "type": 0,
    "en": "Entertainment Activities",
    "vi": "Hoạt Động Giải Trí"
  },
  {
    "key": "info_menu_entertaiment",
    "type": 0,
    "en": "The amount of entertainment activity a settler requires. If this need is not met, the settler will be unhappy.",
    "vi": "Nhu cầu vui chơi giải trí của dân làng. Nếu không được đáp ứng, họ sẽ cảm thấy tẻ nhạt và bất mãn."
  },
  {
    "key": "menu_stomach",
    "type": 0,
    "en": "Stomach",
    "vi": "Sức Khỏe Dạ Dày"
  },
  {
    "key": "info_menu_stomach",
    "type": 0,
    "en": "This indicates how well this settler’s stomach is. Drinking alcohol and eating raw food especially meat can cause stomach upsets. If this number reaches 0 the settler will vomit. Carcasses and rotten piles can make the stomach turn as well.",
    "vi": "Tình trạng sức khỏe hệ tiêu hóa của dân làng. Uống nhiều rượu và ăn thực phẩm sống (đặc biệt là thịt sống) sẽ gây đau bụng tiêu chảy. Nếu tụt về 0, dân làng sẽ nôn mửa liên tục."
  },
  {
    "key": "info_menu_blood",
    "type": 0,
    "en": "The amount of blood a person or animal has. Losing blood can result in the villager losing consciousness or if it reaches 0% the settler will die.",
    "vi": "Lượng máu trong cơ thể của người hoặc động vật. Mất máu nghiêm trọng sẽ dẫn đến bất tỉnh; nếu cạn kiệt (0%), đối tượng sẽ tử vong."
  },
  {
    "key": "info_menu_consciousness",
    "type": 0,
    "en": "The amount of consciousness a person or animal has. Losing consciousness can result in loss of motor functions. If it reaches 0% the settler will faint.",
    "vi": "Mức độ tỉnh táo và nhận thức. Mất ý thức sẽ khiến cơ thể tê liệt không thể vận động; nếu tụt về 0%, họ sẽ ngất lịm."
  },
  {
    "key": "info_menu_health",
    "type": 0,
    "en": "The amount of damage a person, animal or object can take before dying.",
    "vi": "Chỉ số sinh lực (máu/HP) tối đa trước khi tử vong hoặc bị phá hủy."
  },
  {
    "key": "info_menu_hunger",
    "type": 0,
    "en": "Food: The amount of nutrition that is consumed. If it reaches 0% the settler will enter starvation mode and eventually die.",
    "vi": "Mức độ no bụng của dân làng. Nếu cạn kiệt (0%), dân làng sẽ rơi vào tình trạng chết đói và dần dần mất mạng."
  },
  {
    "key": "info_menu_pain",
    "type": 0,
    "en": "The amount of pain the settler is experiencing at that moment. Large amounts of pain will result in loss of consciousness.",
    "vi": "Mức độ đau đớn thể xác mà đối tượng đang gánh chịu. Đau đớn vượt ngưỡng chịu đựng sẽ làm mất ý thức ngất xỉu."
  },
  {
    "key": "info_menu_rot",
    "type": 0,
    "en": "Resource pile freshness. When it reaches 0%, this pile will become rotten.",
