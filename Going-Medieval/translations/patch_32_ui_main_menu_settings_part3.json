  },
  {
    "key": "options_camera_target_visuals_info",
    "type": 0,
    "en": "Toggle visuals that represent the camera's target. Visuals will appear only while the camera is moving/zooming/orbiting.",
    "vi": "Bật/tắt biểu tượng hiển thị tâm ngắm của camera. Biểu tượng chỉ xuất hiện khi camera đang di chuyển, thu phóng hoặc xoay."
  },
  {
    "key": "options_camera_target_visuals_duration",
    "type": 0,
    "en": "Camera target visuals duration",
    "vi": "Thời gian hiện tâm ngắm camera"
  },
  {
    "key": "options_camera_target_visuals_duration_info",
    "type": 0,
    "en": "How long camera target visuals remain on screen after the camera action stops.",
    "vi": "Thời gian tâm ngắm camera tiếp tục hiển thị trên màn hình sau khi dừng thao tác camera."
  },
  {
    "key": "options_coyote_time",
    "type": 0,
    "en": "Coyote time",
    "vi": "Độ trễ mép vực"
  },
  {
    "key": "options_coyote_time_info",
    "type": 0,
    "en": "The amount of time the camera target stays airborne when going off a cliff. If camera target visuals are enabled, this is represented by a white line from the target visuals to the next layer the camera target jumps to.",
    "vi": "Khoảng thời gian tâm ngắm camera duy trì độ cao khi lướt qua mép vực. Nếu bật hiển thị tâm ngắm, đường kẻ trắng sẽ nối từ vị trí hiện tại đến tầng tiếp theo mà camera đáp xuống."
  },
  {
    "key": "options_camera_shake",
    "type": 0,
    "en": "Camera Shake",
    "vi": "Rung chấn camera"
  },
  {
    "key": "options_camera_shake_info",
