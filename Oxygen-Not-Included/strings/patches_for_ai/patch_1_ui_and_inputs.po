msgstr ""

#. STRINGS.UI.SPACEARTIFACTS.RUBIKSCUBE.NAME
msgctxt "STRINGS.UI.SPACEARTIFACTS.RUBIKSCUBE.NAME"
msgid "Rubik's Cube"
msgstr ""

