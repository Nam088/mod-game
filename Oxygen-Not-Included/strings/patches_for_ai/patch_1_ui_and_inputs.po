msgctxt "STRINGS.UI.SPACEARTIFACTS.PLASMALAMP.DESCRIPTION"
msgid "No space colony is complete without one."
msgstr ""

#. STRINGS.UI.SPACEARTIFACTS.PLASMALAMP.NAME
msgctxt "STRINGS.UI.SPACEARTIFACTS.PLASMALAMP.NAME"
