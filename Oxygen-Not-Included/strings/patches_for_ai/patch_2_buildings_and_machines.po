msgctxt "STRINGS.BUILDINGS.PREFABS.OXYSCONCE.EFFECT"
msgid ""
"Stores a small chunk of <link=\"OXYROCK\">Oxylite</link> which gradually "
"releases <link=\"OXYGEN\">Oxygen</link> into the environment."
msgstr ""

