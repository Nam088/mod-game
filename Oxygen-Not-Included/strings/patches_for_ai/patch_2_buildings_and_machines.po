msgctxt "STRINGS.BUILDINGS.PREFABS.PEATGENERATOR.EFFECT"
msgid ""
"Burns <link=\"PEAT\">Peat</link> to produce electrical <link=\"POWER\">Power</link>.\n"
"\n"
"Produces a small amount of <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and <link=\"DIRTYWATER\">Polluted Water</link>."
msgstr ""

