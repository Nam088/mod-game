msgctxt "STRINGS.BUILDINGS.PREFABS.PARTYCAKE.EFFECT"
msgid ""
"Increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>.\n"
"\n"
"Adds a <link=\"MORALE\">Morale</link> bonus to Duplicants' parties."
