msgctxt "STRINGS.BUILDINGS.PREFABS.PETROLEUMGENERATOR.EFFECT"
msgid ""
"Converts <link=\"PETROLEUM\">Petroleum</link>, <link=\"ETHANOL\">Ethanol</link> or <link=\"REFINEDLIPID\">Biodiesel</link> into electrical <link=\"POWER\">Power</link>.\n"
"\n"
"Produces <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and <link=\"DIRTYWATER\">Polluted Water</link>."
msgstr ""

