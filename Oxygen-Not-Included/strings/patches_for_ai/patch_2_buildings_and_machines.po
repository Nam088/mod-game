"Light sensors can tell surface bunker doors above solar panels to open or "
"close based on solar light levels."
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.EFFECT"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> or a "
"<b><style=\"logic_off\">Red Signal</style></b> when ambient "
"<link=\"LIGHT\">Brightness</link> enters the chosen range."
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT"
msgid "Ambient <link=\"LIGHT\">Brightness</link>"
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT_ACTIVE"
msgid ""
"Sends a <b><style=\"logic_on\">Green Signal</style></b> if ambient "
"<link=\"LIGHT\">Brightness</link> is within the selected range"
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT_INACTIVE
