msgstr ""

#. STRINGS.BUILDINGS.PREFABS.PIXELPACK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.DESC"
msgid "Four pixels which can be individually designated different colors."
msgstr ""

