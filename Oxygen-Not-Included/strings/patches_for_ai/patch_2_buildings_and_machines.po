msgctxt "STRINGS.BUILDINGS.PREFABS.PIONEERLANDER.NAME"
msgid "<link=\"PIONEERMODULE\">Trailblazer Lander</link>"
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.PIONEERMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PIONEERMODULE.DESC"
