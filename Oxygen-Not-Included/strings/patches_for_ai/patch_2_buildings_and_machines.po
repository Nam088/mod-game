msgctxt "STRINGS.BUILDINGS.PREFABS.OXYLITEREFINERY.EFFECT"
msgid ""
"Synthesizes <link=\"OXYROCK\">Oxylite</link> using "
"<link=\"OXYGEN\">Oxygen</link> and a small amount of "
"<link=\"GOLD\">Gold</link>."
msgstr ""

