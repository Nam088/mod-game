msgctxt "STRINGS.BUILDINGS.PREFABS.SUNLAMP.EFFECT"
msgid ""
"Gives off <link=\"LIGHT\">Sunlight</link> level Lux.\n"
"\n"
"Can be paired with <link=\"BEACHCHAIR\">Beach Chairs</link>."
msgstr ""

