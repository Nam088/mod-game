msgctxt "STRINGS.BUILDINGS.PREFABS.PHONOBOX.NAME"
msgid "<link=\"PHONOBOX\">Jukebot</link>"
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.PIONEERLANDER.DESC
