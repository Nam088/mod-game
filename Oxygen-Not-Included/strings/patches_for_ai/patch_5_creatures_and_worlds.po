msgctxt "STRINGS.WORLDS.MINIFORESTFROZEN.DESCRIPTION"
msgid ""
"A frigid location marked by inhospitably low temperatures throughout.\n"
"\n"
"<smallcaps>The Frozen Forest Asteroid's low temperatures will make finding water and establishing farms or ranches problematic.</smallcaps>\n"
"\n"
msgstr ""

#. STRINGS.WORLDS.MINIFORESTFROZEN.NAME
msgctxt "STRINGS.WORLDS.MINIFORESTFROZEN.NAME"
