msgctxt "STRINGS.WORLDS.MINIMETALLICSWAMPY.DESCRIPTION"
msgid ""
"A small swampy world with an abundance of renewable metal.\n"
"\n"
"<smallcaps>Metallic Swampy Asteroids have a high concentration of metal and a swampy, polluted atmosphere.</smallcaps>"
msgstr ""

#. STRINGS.WORLDS.MINIMETALLICSWAMPY.NAME
msgctxt "STRINGS.WORLDS.MINIMETALLICSWAMPY.NAME"
