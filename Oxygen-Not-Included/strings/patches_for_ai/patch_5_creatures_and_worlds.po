msgstr ""

#. STRINGS.WORLDS.FOREST_DEFAULT.DESCRIPTION
msgctxt "STRINGS.WORLDS.FOREST_DEFAULT.DESCRIPTION"
msgid ""
"A location with a natural abundance of trees.\n"
"\n"
"<smallcaps>Colonizing Arboria will require careful planning right from the start. Because of its lack of metals, finding biological solutions to problems is a must.</smallcaps>\n"
"\n"
msgstr ""

#. STRINGS.WORLDS.FOREST_DEFAULT.NAME
msgctxt "STRINGS.WORLDS.FOREST_DEFAULT.NAME"
msgid "Arboria"
msgstr ""

#. STRINGS.WORLDS.FOREST_HOT.DESCRIPTION
msgctxt "STRINGS.WORLDS.FOREST_HOT.DESCRIPTION"
msgid ""
"A location with oppressively hot temperatures.\n"
"\n"
"<smallcaps>Temperatures on Aridio are much higher than expected. While resources are abundant, maintaining food and infrastructure could be difficult as our colony warms.</smallcaps>\n"
"\n"
msgstr ""

#. STRINGS.WORLDS.FOREST_HOT.NAME
msgctxt "STRINGS.WORLDS.FOREST_HOT.NAME"
msgid "Aridio"
msgstr ""

