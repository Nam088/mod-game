msgctxt "STRINGS.WORLDS.MOOMOONLET.DESCRIPTION"
msgid ""
"A small world with unique local lifeforms.\n"
"\n"
"<smallcaps>Moo Asteroids are the natural breeding ground of Gassy Moos due to their abundance of Gas Grass and Methane.</smallcaps>"
msgstr ""

#. STRINGS.WORLDS.MOOMOONLET.NAME
msgctxt "STRINGS.WORLDS.MOOMOONLET.NAME"
msgid "Moo Asteroid"
msgstr ""

#. STRINGS.WORLDS.MOON_BARREN.DESCRIPTION
msgctxt "STRINGS.WORLDS.MOON_BARREN.DESCRIPTION"
msgid ""
"A smaller planetoid in orbit around a larger, resource rich world.\n"
"\n"
"<smallcaps>Barren Moons are rich in minerals, but Duplicants will need to branch out into space early to find the resources the colony needs to stay alive.</smallcaps>\n"
"\n"
msgstr ""

#. STRINGS.WORLDS.MOON_BARREN.NAME
msgctxt "STRINGS.WORLDS.MOON_BARREN.NAME"
msgid "Barren Moon"
msgstr ""

#. STRINGS.WORLDS.NIOBIUMMOONLET.DESCRIPTION
msgctxt "STRINGS.WORLDS.NIOBIUMMOONLET.DESCRIPTION"
msgid ""
"A small location with an abundance of solid Niobium.\n"
"\n"
"<smallcaps>Superconductive Asteroids offer rich veins of Niobium to Duplicants that can withstand its molten rivers of magma.</smallcaps>"
msgstr ""

#. STRINGS.WORLDS.NIOBIUMMOONLET.NAME
msgctxt "STRINGS.WORLDS.NIOBIUMMOONLET.NAME"
msgid "Superconductive Asteroid"
msgstr ""

#. STRINGS.WORLDS.OASIS.DESCRIPTION
msgctxt "STRINGS.WORLDS.OASIS.DESCRIPTION"
msgid ""
"A desolate location with a cache of life-sustaining water trapped beneath the surface.\n"
"\n"
"<smallcaps>A wide underground desert will pose temperature threats and strain the resources of a colony on Oasisse. However, surviving the challenge should present great industrial opportunities.</smallcaps>\n"
"\n"
msgstr ""

#. STRINGS.WORLDS.OASIS.NAME
msgctxt "STRINGS.WORLDS.OASIS.NAME"
msgid "Oasisse"
msgstr ""

