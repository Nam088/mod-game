#. STRINGS.CODEX.STORY_TRAITS.HIJACK_HEADQUARTERS.DESCRIPTION
msgctxt "STRINGS.CODEX.STORY_TRAITS.HIJACK_HEADQUARTERS.DESCRIPTION"
msgid ""
"Reboot an unsanctioned biogenetic facility.\n"
"\n"
"Once activated, Duplicants can use it to siphon energy from the Printing Pod to power on-demand printing of...something.\n"
"\n"
"It smells a bit like an old ranch."
msgstr ""

#. STRINGS.CODEX.STORY_TRAITS.HIJACK_HEADQUARTERS.DESCRIPTION_SHORT
msgctxt "STRINGS.CODEX.STORY_TRAITS.HIJACK_HEADQUARTERS.DESCRIPTION_SHORT"
msgid ""
"Reboot an unsanctioned biogenetic facility that siphons energy from the "
"Printing Pod."
msgstr ""

