msgstr ""

#. STRINGS.CODEX.MOLTEN.BODY.CONTAINER2
msgctxt "STRINGS.CODEX.MOLTEN.BODY.CONTAINER2"
msgid ""
"Slicksters are amicable creatures famous amongst breeders for their good personalities and smiley faces.\n"
"\n"
"Slicksters rarely if ever nip at human handlers, and are considered non-ideal house pets only for the oily mess they involuntarily leave behind wherever they go."
msgstr ""

#. STRINGS.CODEX.MOLTEN.SUBTITLE
msgctxt "STRINGS.CODEX.MOLTEN.SUBTITLE"
msgid "Critter Morph"
msgstr ""

