#. STRINGS.CODEX.BASICBOOSTER.BODY.CONTAINER1
msgctxt "STRINGS.CODEX.BASICBOOSTER.BODY.CONTAINER1"
msgid ""
"A supplement that minorly reduces the chance of contracting a <style=\"KKeyword\">Germ</style>-based <link=\"DISEASE\">Disease</link>.\n"
"\n"
"Must be taken daily."
msgstr ""

#. STRINGS.CODEX.BASICBOOSTER.SUBTITLE
msgctxt "STRINGS.CODEX.BASICBOOSTER.SUBTITLE"
msgid "Health Supplement"
msgstr ""

#. STRINGS.CODEX.BASICBOOSTER.TITLE
msgctxt "STRINGS.CODEX.BASICBOOSTER.TITLE"
msgid "Vitamin Chews"
msgstr ""

#. STRINGS.CODEX.BASICCURE.BODY.CONTAINER1
msgctxt "STRINGS.CODEX.BASICCURE.BODY.CONTAINER1"
msgid ""
"Duplicants can take this to cure themselves of minor <style=\"KKeyword\">Germ</style>-based <link=\"DISEASE\">Diseases</link>.\n"
"\n"
"Curative Tablets are very effective against <link=\"FOODSICKNESS\">Food Poisoning</link>."
msgstr ""

#. STRINGS.CODEX.BASICCURE.SUBTITLE
msgctxt "STRINGS.CODEX.BASICCURE.SUBTITLE"
msgid "Self-Administered Medicine"
msgstr ""

#. STRINGS.CODEX.BASICCURE.TITLE
msgctxt "STRINGS.CODEX.BASICCURE.TITLE"
msgid "Curative Tablet"
msgstr ""

#. STRINGS.CODEX.BASICRADPILL.BODY.CONTAINER1
msgctxt "STRINGS.CODEX.BASICRADPILL.BODY.CONTAINER1"
msgid ""
"A supplement that speeds up the rate at which a Duplicant body absorbs radiation, allowing them to manage increased radiation exposure.\n"
"\n"
"Must be taken daily."
msgstr ""

#. STRINGS.CODEX.BASICRADPILL.SUBTITLE
msgctxt "STRINGS.CODEX.BASICRADPILL.SUBTITLE"
msgid "Radiation Recovery"
msgstr ""

#. STRINGS.CODEX.BASICRADPILL.TITLE
