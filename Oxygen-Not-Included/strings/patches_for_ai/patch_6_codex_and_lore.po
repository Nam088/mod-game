msgstr ""

#. STRINGS.CODEX.DENSE.BODY.CONTAINER2
msgctxt "STRINGS.CODEX.DENSE.BODY.CONTAINER2"
msgid ""
"The Puft is an easy creature to raise for first time handlers given its wholly amiable disposition and suggestible nature.\n"
"\n"
"It is unusually tolerant of human handling and will allow itself to be patted or scratched nearly anywhere on its fuzzy body, including, unnervingly, directly on any of its three eyeballs."
msgstr ""

#. STRINGS.CODEX.DENSE.SUBTITLE
msgctxt "STRINGS.CODEX.DENSE.SUBTITLE"
msgid "Critter Morph"
msgstr ""

#. STRINGS.CODEX.DENSE.TITLE
