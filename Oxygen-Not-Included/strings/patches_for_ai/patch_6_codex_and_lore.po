msgstr ""

#. STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.END_POPUP.DESCRIPTION
msgctxt "STRINGS.CODEX.STORY_TRAITS.CRITTER_MANIPULATOR.END_POPUP.DESCRIPTION"
msgid ""
"Success! Sufficient samples collected.\n"
"\n"
"I can now trigger genetic deviations in base morphs by sending them through the scanner.\n"
"\n"
"Existing variants can also be scanned, but their genetic makeup is too unstable to tolerate further manipulation."
msgstr ""

