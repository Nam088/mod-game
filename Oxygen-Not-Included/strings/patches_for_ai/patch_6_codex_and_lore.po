msgstr ""

#. STRINGS.CODEX.DEWDRIP.BODY.CONTAINER1
msgctxt "STRINGS.CODEX.DEWDRIP.BODY.CONTAINER1"
msgid ""
"A crystallized blob of <link=\"MILK\">Brackene</link> from the <link=\"DEWDRIPPERPLANT\">Dew Dripper</link>.\n"
"\n"
"It must be processed at the <link=\"MILKPRESS\">Plant Pulverizer</link> to release its contents."
msgstr ""

#. STRINGS.CODEX.DEWDRIP.SUBTITLE
msgctxt "STRINGS.CODEX.DEWDRIP.SUBTITLE"
msgid "Plant Byproduct"
msgstr ""

#. STRINGS.CODEX.DEWDRIP.TITLE
