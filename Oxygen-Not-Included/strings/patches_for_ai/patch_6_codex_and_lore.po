msgstr ""

#. STRINGS.CODEX.BASIC_FABRIC.BODY.CONTAINER1
msgctxt "STRINGS.CODEX.BASIC_FABRIC.BODY.CONTAINER1"
msgid ""
"A ball of raw cellulose harvested from a <link=\"BASICFABRICPLANT\">Thimble Reed</link>.\n"
"\n"
"It is used in the production of <link=\"EQUIPMENT\">Clothing</link> and textiles."
msgstr ""

#. STRINGS.CODEX.BASIC_FABRIC.SUBTITLE
msgctxt "STRINGS.CODEX.BASIC_FABRIC.SUBTITLE"
