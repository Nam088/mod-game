msgctxt "STRINGS.CODEX.LIGHT.HEADER_1"
msgid "Light"
msgstr ""

#. STRINGS.CODEX.LIGHT.HEADER_2
msgctxt "STRINGS.CODEX.LIGHT.HEADER_2"
msgid "Light Sources"
msgstr ""

#. STRINGS.CODEX.LIGHT.HEADER_3
msgctxt "STRINGS.CODEX.LIGHT.HEADER_3"
