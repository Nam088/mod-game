  "STRINGS.MISC.TAGS.STORYTRAITRESOURCE": "Đặc Điểm Cốt Truyện",
  "STRINGS.MISC.TAGS.SUBLIMATING": "<link=\"SUBLIMATES\">Chất Thăng Hoa</link>",
  "STRINGS.MISC.TAGS.SUBLIMATING_DESC": "Chất thăng hoa là nhóm nguyên tố <link=\"ELEMENTSSOLID\">Chất Rắn</link> tự động bốc hơi thụ động sang trạng thái <link=\"ELEMENTSGAS\">Khí</link>. Khi quá trình thoát khí hoàn tất, sẽ không còn lại dấu vết nào của chất rắn ban đầu.\n\nSự biến đổi thụ động này vẫn tiếp diễn ngay cả khi nguyên tố được cất giữ trong kho.",
  "STRINGS.MISC.TAGS.SUBLIMATING_SUBHEADER": "Nguyên Tố Thoát Khí",
  "STRINGS.MISC.TAGS.SUIT": "Đồ Bảo Hộ",
  "STRINGS.MISC.TAGS.SWIMMINGCREATURE": "Sinh Vật Thủy Sinh",
  "STRINGS.MISC.TAGS.TECHCOMPONENTS": "<link=\"TECHCOMPONENTS\">Linh Kiện Công Nghệ</link>",
