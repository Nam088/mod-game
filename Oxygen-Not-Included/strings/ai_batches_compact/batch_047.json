{
  "STRINGS.MISC.TAGS.EXTRUDABLE": "Có Thể Ép Đùn",
  "STRINGS.MISC.TAGS.FABRICATING": "Giao Hàng Chế Tạo",
  "STRINGS.MISC.TAGS.FARMABLE": "<link=\"FARMABLE\">Đất Trồng Trọt</link>",
  "STRINGS.MISC.TAGS.FARMABLE_DESC": "Đất trồng trọt là khối xây dựng cơ bản cho các hệ thống nông nghiệp và cũng rất hữu ích trong việc sản xuất <link=\"OXYGEN\">Oxy</link> sạch.",
  "STRINGS.MISC.TAGS.FARMING": "Giao Hàng-Xây Nông Trại",
  "STRINGS.MISC.TAGS.FARMINGMATERIAL": "Phân Bón",
  "STRINGS.MISC.TAGS.FARMSTATION": "Trạm Canh Tác",
  "STRINGS.MISC.TAGS.FILTER": "<link=\"FILTER\">Vật Liệu Lọc</link>",
  "STRINGS.MISC.TAGS.FILTER_DESC": "Vật liệu lọc là những chất dùng để tách <link=\"ELEMENTSGAS\">khí</link> hoặc <link=\"ELEMENTSLIQUID\">chất lỏng</link> tinh khiết khỏi dạng ô nhiễm của chúng.\n\nChúng là các vật phẩm tiêu hao và sẽ bị biến đổi qua quá trình lọc. Ví dụ: <link=\"SAND\">Cát</link> dùng để lọc <link=\"DIRTYWATER\">Nước Bẩn</link> sẽ biến thành <link=\"TOXICSAND\">Đất Bẩn</link>.",
  "STRINGS.MISC.TAGS.FLYINGCRITTEREDIBLE": "Mồi Nhử",
  "STRINGS.MISC.TAGS.FOSSIL": "Hóa Thạch",
  "STRINGS.MISC.TAGS.FOSSILS": "<link=\"FOSSILS\">Hóa Thạch</link>",
  "STRINGS.MISC.TAGS.FOSSILS_DESC": "Hóa thạch là nhóm các loại đá và khoáng chất hỗn hợp chứa tàn tích của các sinh vật hóa đá.\n\nChúng có nhiều công dụng như làm vật liệu xây dựng cơ bản, khối điêu khắc, hoặc nguyên liệu thô để sản xuất các vật liệu cao cấp hơn.",
  "STRINGS.MISC.TAGS.GAS": "Khí",
  "STRINGS.MISC.TAGS.GENE_SHUFFLER": "Máy Trộn Xung Thần Kinh",
  "STRINGS.MISC.TAGS.GLASS": "Thủy Tinh",
  "STRINGS.MISC.TAGS.GLASSES": "<link=\"GLASSES\">Thủy Tinh Thể</link>",
  "STRINGS.MISC.TAGS.GLASSES_DESC": "Các vật liệu thủy tinh thể nhẵn mịn và trong suốt, cho phép <link=\"LIGHT\">Ánh Sáng</link> xuyên qua.\n\nChúng rất hữu ích trong việc xây dựng các công trình cần chiếu sáng bên trong, cũng như các công trình trưng bày tài nguyên đang chứa.",
  "STRINGS.MISC.TAGS.HABITAT_MODULE": "Khoang Sinh Hoạt",
  "STRINGS.MISC.TAGS.ICE": "Băng",
  "STRINGS.MISC.TAGS.ICEORE": "<link=\"ICEORE\">Băng</link>",
  "STRINGS.MISC.TAGS.ICEORE_DESC": "Băng là nhóm vật liệu được cấu tạo chủ yếu (nếu không phải hoàn toàn) từ <link=\"WATER\">Nước</link> ở thể đóng băng hoặc đóng băng một phần.\n\nLà vật liệu ở trạng thái rắn hoặc bán rắn băng giá, các nguyên tố này rất hữu ích như một cách tiết kiệm để làm mát môi trường xung quanh.\n\nKhi bị đun nóng, băng sẽ tan chảy thành dạng lỏng ban đầu (ví dụ: <link=\"BRINEICE\">Băng Nước Muối</link> sẽ hóa lỏng thành <link=\"BRINE\">Nước Muối</link>). Mỗi loại băng có nhiệt độ đóng băng và tan chảy khác nhau tùy thuộc vào thành phần và trạng thái của nó.",
  "STRINGS.MISC.TAGS.INDUSTRIALINGREDIENT": "<link=\"INDUSTRIALINGREDIENT\">Nguyên Liệu Công Nghiệp</link>",
  "STRINGS.MISC.TAGS.INDUSTRIALPRODUCT": "Sản Phẩm Công Nghiệp",
  "STRINGS.MISC.TAGS.INSULATOR": "<link=\"INSULATOR\">Chất Cách Nhiệt</link>",
  "STRINGS.MISC.TAGS.INSULATOR_DESC": "Chất cách nhiệt có độ dẫn nhiệt thấp, giúp giảm tốc độ truyền <link=\"HEAT\">Nhiệt</link> qua chúng một cách hiệu quả.",
  "STRINGS.MISC.TAGS.LARGESEED": "Hạt Giống",
  "STRINGS.MISC.TAGS.LEAD": "<link=\"LEAD\">Chì</link>",
  "STRINGS.MISC.TAGS.LIFE": "Sự Sống",
  "STRINGS.MISC.TAGS.LIQUID": "<link=\"ELEMENTSLIQUID\">Chất Lỏng</link>",
  "STRINGS.MISC.TAGS.LIQUIFIABLE": "Có Thể Hóa Lỏng",
  "STRINGS.MISC.TAGS.LONGRANGEMISSILE": "Tên Lửa Tầm Xa",
  "STRINGS.MISC.TAGS.LUBRICATINGOIL": "<link=\"LUBRICATINGOIL\">Dầu Bánh Răng</link>",
  "STRINGS.MISC.TAGS.LUBRICATINGOIL_DESC": "Dầu bánh răng là chất lỏng bôi trơn hữu ích trong việc bảo dưỡng máy móc phức tạp, bảo vệ hệ thống bánh răng khỏi hao mòn hư hại và giảm thiểu ma sát giữa các bộ phận chuyển động để duy trì hiệu suất tối ưu.",
  "STRINGS.MISC.TAGS.MACHINE_SHOP": "Xưởng Cơ Khí",
  "STRINGS.MISC.TAGS.MANUFACTUREDMATERIAL": "Vật Liệu Đã Chế Tạo",
  "STRINGS.MISC.TAGS.MARKEDFORCOMPOST": "Đã Đánh Dấu Ủ Phân",
  "STRINGS.MISC.TAGS.MARKEDFORCOMPOSTINSTORAGE": "Trong Kho Ủ Phân",
  "STRINGS.MISC.TAGS.MASSAGE_TABLE": "Bàn Mát-xa",
  "STRINGS.MISC.TAGS.MEDICALSUPPLIES": "Vật Tư Y Tế",
  "STRINGS.MISC.TAGS.MEDICINE": "Thuốc Men",
  "STRINGS.MISC.TAGS.MESSSTATION": "Bàn Ăn",
  "STRINGS.MISC.TAGS.METAL": "<link=\"METAL\">Quặng Kim Loại</link>",
  "STRINGS.MISC.TAGS.METAL_DESC": "Quặng kim loại là dạng thô của kim loại, có rất nhiều ứng dụng thực tế trong thiết bị điện tử và xây dựng chung.\n\nQuặng kim loại thường được tinh chế thành <link=\"REFINEDMETAL\">Kim Loại Tinh Chế</link> bằng <link=\"ROCKCRUSHER\">Máy Nghiền Đá</link> hoặc <link=\"METALREFINERY\">Nhà Máy Luyện Kim</link>.\n\nMột số quặng kim loại hiếm cũng có thể được tinh chế trong <link=\"SUPERMATERIALREFINERY\">Lò Rèn Phân Tử</link>.",
  "STRINGS.MISC.TAGS.MIXTURE": "Hỗn Hợp",
  "STRINGS.MISC.TAGS.MULTITOOL": "Dụng Cụ Đa Năng",
  "STRINGS.MISC.TAGS.NONCRUSHABLE": "Không Thể Nghiền",
  "STRINGS.MISC.TAGS.OBSIDIAN": "<link=\"OBSIDIAN\">Hắc Diệu Thạch</link>",
  "STRINGS.MISC.TAGS.OIL": "Hydrocacbon",
  "STRINGS.MISC.TAGS.ORE": "Quặng",
  "STRINGS.MISC.TAGS.ORGANICS": "Hữu Cơ",
  "STRINGS.MISC.TAGS.ORGANICS_DESC": "Vật liệu hữu cơ là các nguyên liệu hữu ích thu thập từ môi trường xung quanh, thu hoạch từ <link=\"PLANTS\">thực vật</link> hoặc thu được từ <link=\"CREATURES\">sinh vật</link>.\n\nMột số loại cần qua chế biến bổ sung trước khi có thể sử dụng.",
  "STRINGS.MISC.TAGS.ORNAMENT": "<link=\"ORNAMENT\">Đồ Trang Trí</link>",
  "STRINGS.MISC.TAGS.ORNAMENTDISPLAYED": "Đồ Trang Trí",
  "STRINGS.MISC.TAGS.OTHER": "Khác",
  "STRINGS.MISC.TAGS.OXIDIZER": "Chất Oxy Hóa",
  "STRINGS.MISC.TAGS.OXYGENCANISTER": "Bình Oxy",
  "STRINGS.MISC.TAGS.PEDESTALDISPLAYABLE": "Vật Phẩm Bục Trưng Bày Khác",
  "STRINGS.MISC.TAGS.PHOSPHORUS": "<link=\"PHOSPHORUS\">Photpho</link>",
  "STRINGS.MISC.TAGS.PICKLED": "Đã Muối Chua",
  "STRINGS.MISC.TAGS.PLASTIC": "<link=\"PLASTIC\">Nhựa</link>",
  "STRINGS.MISC.TAGS.PLASTIC_DESC": "Nhựa là các <link=\"ELEMENTSSOLID\">Chất Rắn</link> tổng hợp dễ uốn và giảm thiểu sự truyền <link=\"HEAT\">Nhiệt</link>. Chúng thường có điểm nóng chảy thấp, mặc dù các loại nhựa cao cấp hơn đã được phát triển để khắc phục vấn đề này.",
  "STRINGS.MISC.TAGS.PLASTIFIABLELIQUID": "<link=\"PLASTIFIABLELIQUID\">Monomer Nhựa</link>",
  "STRINGS.MISC.TAGS.PLASTIFIABLELIQUID_DESC": "Monomer nhựa là các hợp chất hữu cơ có thể được xử lý thành <link=\"PLASTIC\">Nhựa</link>, có ứng dụng giá trị làm vật liệu xây dựng tiên tiến.\n\nNhựa có nguồn gốc từ các monomer này cũng có thể dùng làm vật liệu đóng gói để bảo quản <link=\"FOOD\">Thực Phẩm</link>.",
  "STRINGS.MISC.TAGS.PLUMBABLE": "<link=\"PLUMBABLE\">Có Thể Đi Đường Ống</link>",
  "STRINGS.MISC.TAGS.PLUMBABLE_DESC": "",
  "STRINGS.MISC.TAGS.POLYPROPYLENE": "<link=\"POLYPROPYLENE\">Nhựa</link>",
  "STRINGS.MISC.TAGS.POWER": "Giao Hàng Máy Phát Điện",
  "STRINGS.MISC.TAGS.POWERSTATION": "Trạm Điện Năng",
  "STRINGS.MISC.TAGS.PRECIOUSMETAL": "<link=\"PRECIOUSMETAL\">Kim Loại Quý</link>",
  "STRINGS.MISC.TAGS.PRECIOUSROCK": "<link=\"PRECIOUSROCK\">Đá Quý</link>",
  "STRINGS.MISC.TAGS.PRECIOUSROCK_DESC": "Đá quý là các khoáng vật thô. Độ cứng cực cao của chúng tạo ra các tác phẩm <link=\"DECOR\">Trang Trí</link> bền đẹp.\n\nMột số loại đá quý vốn dĩ đã bắt mắt ngay cả ở dạng tự nhiên, chưa qua gia công.",
  "STRINGS.MISC.TAGS.RAILGUNPAYLOADEMPTYABLE": "Kiện Hàng Pháo Điện Từ",
  "STRINGS.MISC.TAGS.RAREMATERIALS": "Tài Nguyên Hiếm",
  "STRINGS.MISC.TAGS.RAW": "Sản Phẩm Sinh Vật Thô",
  "STRINGS.MISC.TAGS.RAWPRECIOUSMETAL": "Quặng Kim Loại Quý",
  "STRINGS.MISC.TAGS.REFINEDMETAL": "<link=\"REFINEDMETAL\">Kim Loại Tinh Chế</link>",
  "STRINGS.MISC.TAGS.REFINEDMETAL_DESC": "Kim loại tinh chế là dạng kim loại đã được làm sạch, thường được dùng trong các thiết bị điện tử cấp cao nhờ khả năng chịu nhiệt độ cao hơn khi làm thành dây điện. Các lợi ích khác bao gồm tăng giá trị trang trí đối với một số kim loại, giúp cải thiện đáng kể tinh thần của thuộc địa.\n\nQuặng kim loại có thể được tinh chế trong <link=\"ROCKCRUSHER\">Máy Nghiền Đá</link> hoặc <link=\"METALREFINERY\">Nhà Máy Luyện Kim</link>.",
  "STRINGS.MISC.TAGS.RELAXATION_POINT": "Khu Vực Giải Trí",
  "STRINGS.MISC.TAGS.REMOTEOPERABLE": "<link=\"REMOTEOPERABLE\">Có Thể Điều Khiển Từ Xa</link>",
  "STRINGS.MISC.TAGS.REMOTEOPERABLE_DESC": "Các công trình này có thể được vận hành từ xa bằng <link=\"REMOTEWORKTERMINAL\">Bộ Điều Khiển Từ Xa</link> miễn là chúng được xây dựng trong phạm vi của một <link=\"REMOTEWORKERDOCK\">Đế Robot Từ Xa</link>.",
  "STRINGS.MISC.TAGS.RESEARCH": "Giao Hàng Nghiên Cứu",
  "STRINGS.MISC.TAGS.RUBBER": "Cao Su",
  "STRINGS.MISC.TAGS.SEED": "Hạt Giống",
  "STRINGS.MISC.TAGS.SHOES": "<link=\"EQUIPMENT\">Giày Dép</link>",
  "STRINGS.MISC.TAGS.SLIPPERY": "<link=\"SLIPPERY\">Trơn Trượt</link>",
  "STRINGS.MISC.TAGS.SLIPPERY_DESC": "Một số <link=\"ELEMENTSLIQUID\">chất lỏng</link> và <link=\"ELEMENTSSOLID\">chất rắn</link> có hệ số ma sát cực kỳ thấp. Chúng gây nguy cơ mất an toàn nếu để trên mặt đất, vì các Đệ có thể bị trượt chân ngã khi đi qua.",
  "STRINGS.MISC.TAGS.SNOW": "<link=\"STABLESNOW\">Tuyết</link>",
  "STRINGS.MISC.TAGS.SOLID": "<link=\"ELEMENTSSOLID\">Chất Rắn</link>",
